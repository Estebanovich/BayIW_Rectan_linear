(PID.TID 0012.0001) > # Open-boundaries
(PID.TID 0012.0001) > &OBCS_PARM01
(PID.TID 0012.0001) > OB_Jsouth = 560*1,
(PID.TID 0012.0001) > OB_Jnorth = 560*0,
(PID.TID 0012.0001) > OB_Iwest = 352*1,
(PID.TID 0012.0001) > OB_Ieast = 352*-1,
(PID.TID 0012.0001) > useOrlanskiSouth=.TRUE.,
(PID.TID 0012.0001) > useOrlanskiWest= .TRUE.,
(PID.TID 0012.0001) > useOrlanskiEast= .TRUE.,
(PID.TID 0012.0001) > useOBCSsponge=.TRUE.,
(PID.TID 0012.0001) > useLinearSponge=.FALSE.,
(PID.TID 0012.0001) > OBCSsponge_Salt=.FALSE.,
(PID.TID 0012.0001) > OBCSsponge_Theta=.FALSE.,
(PID.TID 0012.0001) > useOBCSbalance=.TRUE.,
(PID.TID 0012.0001) > useOBCSprescribe=.FALSE.,
(PID.TID 0012.0001) > OBCS_balanceFacS=-1.,
(PID.TID 0012.0001) > OBCS_balanceFacW=1.,
(PID.TID 0012.0001) > OBCS_balanceFacE=1.,
(PID.TID 0012.0001) > OBCS_monitorFreq=1200.,
(PID.TID 0012.0001) > &
(PID.TID 0012.0001) >
(PID.TID 0012.0001) > &OBCS_PARM02
(PID.TID 0012.0001) ># cvelTimeScale: averaging period for Orlanski phase speed (s).
(PID.TID 0012.0001) >#   Shortened 1000->250 so the estimate tracks the fast waves
(PID.TID 0012.0001) >#   (cell crossing time ~67 s at c=sqrt(gH)~75 m/s, dx=5 km).
(PID.TID 0012.0001) ># CMAX: max non-dimensional phase speed (CFL) allowed by Orlanski.
(PID.TID 0012.0001) >#   AB-II is stable only for CMAX<0.5 (orlanski_*.F); 1.0 was unstable.
(PID.TID 0012.0001) > cvelTimeScale=250.0,
(PID.TID 0012.0001) > CMAX=0.45,
(PID.TID 0012.0001) > &
(PID.TID 0012.0001) >
(PID.TID 0012.0001) >
(PID.TID 0012.0001) > &OBCS_PARM03
(PID.TID 0012.0001) ># Sponge (flow-relaxation) backs up the radiation. On the 5 km grid the
(PID.TID 0012.0001) ># barotropic mode has c*dt/dx~0.45 (right at the Orlanski/AB-II limit);
(PID.TID 0012.0001) ># the stretched margins (input/make_stretched_grid.py) drop it to ~0.17 so
(PID.TID 0012.0001) ># Orlanski radiates with margin, and this sponge absorbs the remainder.
(PID.TID 0012.0001) > spongeThickness=30,
(PID.TID 0012.0001) > Urelaxobcsinner=1200.E0,
(PID.TID 0012.0001) > Vrelaxobcsinner=1200.E0,
(PID.TID 0012.0001) > Urelaxobcsbound=60.E0,
(PID.TID 0012.0001) > Vrelaxobcsbound=60.E0,
(PID.TID 0012.0001) > &
(PID.TID 0012.0001) 
